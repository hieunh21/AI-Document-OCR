# Copy to .env and adjust. Never commit .env.

# --- Backend ---
VIETDOCAI_ENV=dev
VIETDOCAI_API_PREFIX=/api/v1
VIETDOCAI_CORS_ORIGINS=http://localhost:5173
VIETDOCAI_STORAGE_DIR=storage
VIETDOCAI_MAX_UPLOAD_MB=10

# --- Database (Phase 5) ---
VIETDOCAI_DATABASE_URL=postgresql+psycopg://vietdocai:vietdocai@localhost:5432/vietdocai

# --- Dataset (Phase 1) ---
VIETDOCAI_MCOCR_DIR=data/raw/mcocr

# --- Optional external LLM/VLM for KIE benchmark (Phase 3B) ---
# Check the data usage terms in docs/data_usage.md before sending any image or text.
# LLM_API_KEY=
