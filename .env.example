# Copy to .env and adjust. Never commit .env.

# --- Backend ---
VIETDOCAI_ENV=dev
VIETDOCAI_API_PREFIX=/api/v1
VIETDOCAI_CORS_ORIGINS=http://localhost:5173
VIETDOCAI_STORAGE_DIR=storage
VIETDOCAI_MAX_UPLOAD_MB=10
VIETDOCAI_UPLOADS_PER_MINUTE=30        # per client address; 0 = no limit
# VIETDOCAI_API_KEY=                   # set to require an X-API-Key header on /api/v1

# --- Inference (Phase 5): a pipeline from configs/pipeline.json ---
VIETDOCAI_PIPELINE=default             # default | llm (needs GEMINI_API_KEY)
VIETDOCAI_DEVICE=gpu:0                 # or cpu
VIETDOCAI_WARMUP=false                 # true = load the models at startup

# --- Database (Phase 5): docker compose up -d db ---
VIETDOCAI_DATABASE_URL=postgresql+psycopg://vietdocai:vietdocai@localhost:5432/vietdocai

# --- Dataset (Phase 1) ---
VIETDOCAI_MCOCR_DIR=data/raw/mcocr

# --- LLM KIE candidate (Phase 3B): Gemini via google-genai ---
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://api.shopaikey.com   # omit to call Google directly
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_THINKING_BUDGET=                     # empty = model default, 0 = no thinking
